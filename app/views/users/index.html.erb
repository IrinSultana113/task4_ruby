<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h2>User Management Panel</h2>
    <%= link_to 'Logout', logout_path, data: { turbo_method: :delete }, class: 'btn btn-outline-danger btn-sm' %>
  </div>

  <% if flash[:notice] %>
    <div class="alert alert-success alert-dismissible fade show" role="alert">
      <%= flash[:notice] %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% end %>

  <% if flash[:alert] %>
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
      <%= flash[:alert] %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% end %>

  <%= form_with url: '', method: :post, id: 'user-management-form' do %>
    <div class="card p-2 mb-3 bg-light shadow-sm">
      <div class="btn-toolbar gap-2" role="toolbar">
        <button type="submit" formaction="<%= block_selected_users_path %>" class="btn btn-warning btn-sm">
          <i class="bi bi-lock"></i>
        </button>
        <button type="submit" formaction="<%= unblock_selected_users_path %>" class="btn btn-success btn-sm">
          <i class="bi bi-unlock"></i>
        </button>
        <button type="submit" 
                formaction="<%= delete_selected_users_path %>" 
                class="btn btn-danger btn-sm" 
                onclick="return confirmDelete();">
          <i class="bi bi-trash"></i> 
        </button>
      </div>
    </div>

    <div class="table-responsive">
      <table class="table table-striped table-bordered align-middle">
        <thead class="table-dark">
          <tr>
            <th scope="col" style="width: 40px;"><input type="checkbox" id="select-all"></th>
            <th scope="col">Name</th>
            <th scope="col">Email</th>
            <th scope="col">Job Position</th>
            <th scope="col">Status</th>
            <th scope="col">Last Seen</th>
          </tr>
        </thead>
        <tbody>
          <% @users.each do |user| %>
            <tr>
              <td><%= check_box_tag 'user_ids[]', user.id, false, class: 'user-checkbox' %></td>
              <td><strong><%= user.full_name %></strong></td>
              <td><%= user.email %></td>
              <td><%= user.job_position %></td>
              <td>
                <span class="badge <%= user.status == 'active' ? 'bg-success' : 'bg-secondary' %>">
                  <%= user.status.capitalize %>
                </span>
              </td>
              <td><%= user.last_seen&.strftime('%d/%m/%Y, %H:%M:%S') %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>

<script>
  document.getElementById('select-all').addEventListener('change', function() {
    let checkboxes = document.querySelectorAll('.user-checkbox');
    checkboxes.forEach(cb => cb.checked = this.checked);
  });
</script>