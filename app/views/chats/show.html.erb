
<div class="container mt-4" style="max-width: 850px">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Ask AI About Users</h2>
    <%= link_to "Back to Users", users_path,
        class: "btn btn-outline-primary btn-sm" %>
  </div>

  <div class="card shadow-sm">
    <div class="card-body">
      <%= form_with url: chat_path, method: :post, data: { turbo: false } do |form| %>
        <div class="mb-3">
          <%= form.label :question, "Ask a question",
              class: "form-label fw-semibold" %>

          <%= form.text_area :question,
              value: @question,
              class: "form-control",
              rows: 3,
              maxlength: 1000,
              required: true,
              placeholder: "Example: How many active users are there?" %>
        </div>

        <%= form.submit "Ask AI",
            class: "btn btn-primary" %>
      <% end %>

      <% if @answer.present? %>
        <div class="alert alert-info mt-4 mb-0">
          <strong>Answer</strong>
          <div class="mt-2" style="white-space: pre-wrap"><%= @answer %></div>
        </div>
      <% end %>
    </div>
  </div>
</div>
