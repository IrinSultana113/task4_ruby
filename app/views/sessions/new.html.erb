<div class="container mt-5" style="max-width: 400px;">
  <div class="card shadow-sm p-4">
    <h3 class="text-center mb-4">Sign In to The App</h3>

    <% if flash[:alert] %>
      <div class="alert alert-danger mb-3"><%= flash[:alert] %></div>
    <% end %>

    <% if flash[:notice] %>
      <div class="alert alert-success mb-3"><%= flash[:notice] %></div>
    <% end %>

    <%= form_with url: login_path, local: true do |form| %>
      <div class="mb-3">
        <%= form.label :email, "Email", class: 'form-label' %>
        <%= form.email_field :email, class: 'form-control', required: true, placeholder: 'test@example.com' %>
      </div>

      <div class="mb-3">
        <%= form.label :password, "Password", class: 'form-label' %>
        <%= form.password_field :password, class: 'form-control', required: true %>
      </div>

      <div class="d-grid gap-2">
        <%= form.submit 'Sign In', class: 'btn btn-primary' %>
      </div>
    <% end %>

    <div class="text-center mt-3">
      <small>Don't have an account? <%= link_to 'Sign up', signup_path %></small>
    </div>
  </div>
</div>